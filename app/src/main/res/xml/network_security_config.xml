<?xml version="1.0" encoding="utf-8"?>
<!-- Permite links http (comuns em IPTV) e inclui os certificados do Let's Encrypt,
     que faltam em TV Box antigas e fazem capas/canais https não carregarem. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
