<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#241507" /><stroke android:width="3dp" android:color="#FF7A00" /><corners android:radius="14dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#2A2A2A" /><stroke android:width="2dp" android:color="#FF7A00" /><corners android:radius="14dp" /></shape></item>
    <item ><shape android:shape="rectangle"><solid android:color="#161616" /><stroke android:width="1dp" android:color="#262626" /><corners android:radius="14dp" /></shape></item>
</selector>
