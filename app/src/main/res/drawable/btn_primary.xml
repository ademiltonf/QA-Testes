<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="#5A3A1A" /><corners android:radius="26dp" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#FF9A3C" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="26dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#C85A00" /><corners android:radius="26dp" /></shape></item>
    <item ><shape android:shape="rectangle"><solid android:color="#FF7A00" /><corners android:radius="26dp" /></shape></item>
</selector>
