<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:buffered_color="#66FFFFFF"
        app:keep_content_on_player_reset="true"
        app:played_color="@color/orange"
        app:scrubber_color="@color/orange"
        app:show_buffering="when_playing" />

    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/overlay_bg"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/channel_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="560dp"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/epg_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxWidth="560dp"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/epg_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="280dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="@color/orange"
            android:visibility="gone" />

        <TextView
            android:id="@+id/epg_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxWidth="560dp"
            android:maxLines="1"
            android:textColor="@color/text2"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/remind_button"
            style="@style/OxeButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:minHeight="40dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/overlay_bg"
        android:gravity="center"
        android:padding="18dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/fav_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/round_button"
            android:contentDescription="@string/favorite"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_border" />

        <ImageButton
            android:id="@+id/quality_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_button"
            android:contentDescription="@string/quality"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hd" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/prev_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="@drawable/round_button"
        android:contentDescription="@string/prev_channel"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_prev"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/next_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/round_button"
        android:contentDescription="@string/next_channel"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_next"
        android:visibility="gone" />
</FrameLayout>
