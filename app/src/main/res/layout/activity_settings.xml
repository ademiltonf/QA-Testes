<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_side"
        android:paddingTop="16dp"
        android:paddingRight="@dimen/screen_side"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back_button"
                style="@style/OxeIconButton"
                android:layout_marginStart="0dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Relógio grande -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/tile_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textColor="@color/white"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, dd 'de' MMMM 'de' yyyy"
                android:format24Hour="EEEE, dd 'de' MMMM 'de' yyyy"
                android:textColor="#F2FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <include
            android:id="@+id/license_row"
            layout="@layout/settings_row" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_playback"
            android:textColor="@color/orange"
            android:textSize="15sp"
            android:textStyle="bold" />
        <include
            android:id="@+id/quality_row"
            layout="@layout/settings_row" />
        <include
            android:id="@+id/subs_row"
            layout="@layout/settings_row" />
        <include
            android:id="@+id/auto_row"
            layout="@layout/settings_row" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_tools"
            android:textColor="@color/orange"
            android:textSize="15sp"
            android:textStyle="bold" />
        <include
            android:id="@+id/speed_row"
            layout="@layout/settings_row" />
        <include
            android:id="@+id/remote_row"
            layout="@layout/settings_row" />
        <include
            android:id="@+id/reminders_row"
            layout="@layout/settings_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/my_lists"
                android:textColor="@color/orange"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/add_list_button"
                style="@style/OxeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="6dp"
                android:minHeight="44dp"
                android:text="@string/add_list"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/account_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#777777"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
